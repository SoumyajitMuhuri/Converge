{
  "version": 2,
  "buildCommand": "cd server && npm install",
  "installCommand": "cd server && npm install",
  "framework": null,
  "functions": {
    "server/server.js": {
      "maxDuration": 30
    }
  },
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "server/server.js"
    }
  ]
}